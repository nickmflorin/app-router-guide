{
  "name": "app-router-guide",
  "version": "0.2.0",
  "private": true,
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  },
  "description": "Craft Education - The App Router Guide (Astro source, build/output/app-router-guide_html/ is the built output)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && python3 scripts/postbuild_relativize.py && prettier --write --ignore-path scripts/prettierignore-dist --log-level warn \"build/output/app-router-guide_html/**/*.html\" && python3 scripts/build_search_index.py",
    "dist": "python3 scripts/build_dist.py",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "deck:titles": "python3 scripts/deck_titles.py"
  },
  "dependencies": {
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.0",
    "prisma": "^6.2.0",
    "sass": "^1.80.0",
    "tailwindcss": "^4.3.0"
  }
}

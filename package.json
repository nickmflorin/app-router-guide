{
  "name": "app-router-guide",
  "version": "0.2.0",
  "private": true,
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  },
  "description": "Craft Education - The App Router Guide (Astro source, build/app-router-guide_html/ is the built output)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && python3 scripts/postbuild_relativize.py && python3 scripts/build_search_index.py",
    "dist": "python3 scripts/build_dist.py",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.0"
  }
}
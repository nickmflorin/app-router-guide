    direction LR
    X1("Client form<br/>action = archiveProgram"):::blue
    X1 -->|"one typed call"| X2("Server Function<br/>'use server', runs in-process"):::green
    X2 -->|"direct call"| X3("Prisma / your service<br/>not-found, forbidden: distinct + typed"):::green
  end
  linkStyle default stroke:#737373,stroke-width:1.5px
  style DI fill:#ffffff,stroke:#e0e0e0,color:#157a4c,rx:8px,ry:8px
  classDef blue fill:#eaf3fe,stroke:#0070f3,color:#0757ba

<span class="tok-kw">const</span> DRAWERS = [PickLearnersDrawer, ReviewConflictsDrawer, ConfirmAssignmentsDrawer] <span class="tok-kw">as const</span>;

<span class="tok-kw">export function</span> <span class="tok-fn">AssignLearnersFlow</span>({ programId, onClose }: <span class="tok-fn">Props</span>) {
  <span class="tok-kw">const</span> [step, setStep] = <span class="tok-fn">useState</span>(<span class="tok-str">0</span>);

  <span class="tok-com">/* A different drawer component per step. Each advance unmounts the
     entire drawer the user is standing in (container, header, footer,
     open animation, scroll position) and mounts a lookalike. */</span>
  <span class="tok-kw">const</span> StepDrawer = DRAWERS[step];
  <span class="tok-kw">return</span> (
    &lt;<span class="tok-fn">StepDrawer</span>
      <span class="tok-prop">programId</span>={programId}
      <span class="tok-prop">onNext</span>={() =&gt; <span class="tok-fn">setStep</span>((s) =&gt; s + <span class="tok-str">1</span>)}
      <span class="tok-prop">onClose</span>={onClose}
    /&gt;
  );
}</pre>

---
import GuidePage from '../layouts/GuidePage.astro';
import { TOC } from '../data/toc.js';
import Chip from '../components/Chip.astro';
import Callout from '../components/Callout.astro';
import GoDeeper from '../components/GoDeeper.astro';
import Diagram from '../components/Diagram.astro';
import Compare from '../components/Compare.astro';
import CompareCol from '../components/CompareCol.astro';
---

<GuidePage title='The App Router Guide - Craft Education' root='.' cover>
  <div class='kicker'>Craft Education · Engineering</div>
  <h1>The App Router Guide</h1>
  <p class='lede'>
    How to build with Next.js and React the way they are designed to be used: server-first. Patterns
    for composition, data fetching, streaming, and the client/server boundary, and the goals behind
    them.
  </p>

  <Callout kind='voice' title='Why this document exists'>
    <p>
      The architecture and approach we use now will set the stage for the rest of the product's
      life. This guide is the shared mental model: what we optimize for on every page, the patterns
      that get a codebase there, and the signs it has drifted. Read the docs it links to; this is
      the map, they are the territory.
    </p>
  </Callout>

  <h2 style='margin-top: 36px'>The thesis</h2>
  <p>
    On every page, your job is to
    <strong>separate what can be known at first render from what cannot</strong>; then
    <strong>maximize the known</strong>, <strong>contain the unknown</strong>, and
    <strong>decouple the parts</strong>. Everything in this guide is in service of one of those
    three goals. Server-side rendering matters because it makes the "known" surface dramatically
    larger than a browser-only app can ever make it.
  </p>

  <h2>How to read this document</h2>
  <p>
    Every practice in this guide is tagged twice: by <strong>scope</strong> (does it apply to all React,
    or specifically to Next.js?) and by <strong>importance</strong> (how much it matters that we follow
    it).
  </p>
  <div class='legend'>
    <div class='legend-box'>
      <h4>Scope</h4>
      <div class='legend-row'>
        <Chip k='react' /><span class='desc'
          >Applies to any React application, with or without Next.js.</span
        >
      </div>
      <div class='legend-row'>
        <Chip k='next' /><span class='desc'
          >Specific to, or dramatically amplified by, the App Router.</span
        >
      </div>
      <div class='legend-row'>
        <Chip k='ux' /><span class='desc'
          >A general UI/UX practice, independent of the framework; usually a cross-team concern.</span
        >
      </div>
    </div>
    <div class='legend-box'>
      <h4>Importance</h4>
      <div class='legend-row'>
        <Chip k='critical' /><span class='desc'
          >Foundational. Getting this wrong undermines the architecture itself; deviate only with a
          specific, articulable reason; legitimate exceptions are named where they exist.</span
        >
      </div>
      <div class='legend-row'>
        <Chip k='very' /><span class='desc'
          >The default on every page. Occasional exceptions expected; use judgment and be ready to
          explain the deviation.</span
        >
      </div>
      <div class='legend-row'>
        <Chip k='imp' /><span class='desc'
          >A meaningful improvement worth adopting as habit; lowest ceremony to deviate from.</span
        >
      </div>
    </div>
  </div>

  <h2>Contents</h2>
  <div class='toc-grid'>
    {
      TOC.map(group => (
        <div class='toc-part'>
          <div class={`part-name ${group.cls}`}>{group.part}</div>
          {group.items.map(item => (
            <a class='toc-row' href={`sections/${item.file}`}>
              <span class='n'>{item.n}</span>
              <span class='t'>{item.title}</span>
              <span class='d'>{item.d}</span>
            </a>
          ))}
        </div>
      ))
    }
  </div>
</GuidePage>

---
/* The slide deck, viewed inside the guide's Astro app (dev) at /deck.
   DEV-ONLY: this file lives in src/dev/ (not src/pages/), and the /deck route
   is injected by astro.config.mjs only under `astro dev`, so `astro build`
   never emits deck.html. Standalone (not the guide layout): a presentation
   shell whose slides are composed from the live document by deck-view.js,
   reading /api/deck and pulling blocks from the served section pages. */
import '../styles/style.scss';
import '../styles/partials/_deck-view.scss';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>App Router Guide — Deck</title>
  </head>
  <body class='deck-view'>
    <div id='deck-root' class='deck-stage'></div>
    <div id='deck-hud' class='deck-hud'></div>
    <script src='/assets/deck-view.js' is:inline></script>
  </body>
</html>

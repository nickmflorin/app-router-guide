generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./notes.db"
}

model Note {
  id         String  @id
  page       String // section file, e.g. "09-server-resolvable-state.html"; or "deck" for deck notes
  kind       String  @default("note") // NoteKind: "note"
  surface    String  @default("doc") // NoteSurface: "doc" | "deck"
  status     String  @default("open") // NoteStatus: "open" | "resolved"
  text       String
  resolution String?

  // How the pin re-anchors to a node in the rendered page.
  targetAnchor  String? // nearest id/anchor
  targetTag     String? // element tag, e.g. "h3"
  targetSnippet String? // a bit of the target's text, for disambiguation
  targetPath    String? // JSON-encoded child-index path, e.g. "[26]"

  // Deck-inclusion notes link to the slide or item they annotate (else null).
  slideId     String?
  slide       Slide?     @relation(fields: [slideId], references: [id], onDelete: Cascade)
  slideItemId String?
  slideItem   SlideItem? @relation(fields: [slideItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page])
  @@index([status])
  @@index([surface])
  @@index([slideId])
  @@index([slideItemId])
}

// A single slide in the deck. Holds one or more referenced content blocks.
model Slide {
  id        String   @id
  order     Int      @default(0) // position of the slide in the deck
  title     String? // manual title (used only when autoTitle is false)
  autoTitle Boolean  @default(true) // derive the title from the first block's nearest heading
  layout    String   @default("free") // SlideLayout: "free" | "row" | "column" | "grid"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SlideItem[]
  notes Note[]

  @@index([order])
}

// A reference to one doc content block placed on a slide. Stores only the
// reference (page + stable contentRef); the content itself is resolved from the
// live document at dev/build time, never copied here.
model SlideItem {
  id         String   @id
  slideId    String
  slide      Slide    @relation(fields: [slideId], references: [id], onDelete: Cascade)
  page       String // section file the referenced block lives on
  contentRef String // stable id of the block in the doc (e.g. "diagram:12.1-...")
  order      Int      @default(0) // position within the slide
  included   Boolean  @default(true) // staged in but temporarily excluded when false
  altText    String? // Claude-authored condensed HTML, rendered on the slide INSTEAD of the live block when set
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes Note[]

  @@index([slideId])
  @@index([page])
}

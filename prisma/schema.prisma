generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./notes.db"
}

model Note {
  id         String  @id
  page       String // section file, e.g. "09-server-resolvable-state.html"
  // SQLite can't hold a native Prisma enum, so `kind` and `status` are string
  // columns whose allowed values are the enums in server/note-enums.mjs
  // (NoteKind, NoteStatus); every writer validates against them.
  kind       String  @default("note") // NoteKind: "note" | "slide"
  status     String  @default("open") // NoteStatus: "open" | "resolved"
  text       String
  resolution String? // free-text resolution write-up (null until resolved)

  // How the pin re-anchors to a node in the rendered page.
  targetAnchor  String? // nearest id/anchor
  targetTag     String? // element tag, e.g. "h3"
  targetSnippet String? // a bit of the target's text, for disambiguation
  targetPath    String? // JSON-encoded child-index path, e.g. "[26]"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page])
  @@index([status])
}
